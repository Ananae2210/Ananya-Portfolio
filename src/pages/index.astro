---
import Base from "../layouts/Base.astro";
import SkillsMarquee from "../components/SkillsMarquee.astro";
import FeaturedStack from "../components/FeaturedStack.astro";
import FeaturedCarousel from "../components/FeaturedCarousel.astro";
import { site } from "../data/site";
import { projects } from "../data/projects";

const experience = [
  { org: "A healthcare data platform", role: "UI/UX Associate", when: "Sep 2024 – Present",
    text: "Designing dashboards, a 60-page website and 250+ product screens, and learning that a shared design system saves more time than any single screen." },
  { org: "IBM", role: "Summer Intern", when: "Jul 2023 – Sep 2023",
    text: "Explored realistic rendering techniques for animation, which taught me how much iteration and small visual details matter." },
  { org: "UPES", role: "B.Tech, Computer Science", when: "2021 – 2024",
    text: "Built games, a game engine and a blockchain supply-chain system, so I design knowing how things actually get built." },
];
const stats = [
  { value: "2+", label: "Years designing" },
  { value: "250+", label: "Product screens designed" },
  { value: "5", label: "Healthcare products" },
];
const tools = [
  { mono: "Fg", name: "Figma", cat: "UI & prototyping" },
  { mono: "Xd", name: "Adobe XD", cat: "UI & prototyping" },
  { mono: "Ai", name: "Adobe Illustrator", cat: "Vector & illustration" },
  { mono: "Ps", name: "Adobe Photoshop", cat: "Image editing" },
  { mono: "Id", name: "Adobe InDesign", cat: "Layout & print" },
  { mono: "Bi", name: "Power BI", cat: "Data & dashboards" },
  { mono: "Cl", name: "Claude", cat: "AI assistant" },
  { mono: "Gp", name: "ChatGPT", cat: "AI assistant" },
  { mono: "Pp", name: "PowerPoint", cat: "Presentations" },
];
---
<Base active="home">
  <!-- Hero -->
  <section class="hero page px">
    <div class="name-row">
      <h1 class="display d-xxl name">Ananya<br />Asthana</h1>
      <p class="label-m muted role">UI/UX &amp;<br />Visual Design</p>
    </div>
    <p class="display d-l manifesto">
      <span>Complex data in.</span>
      <span class="accent">Clear decisions out.</span>
    </p>
    <div class="ctas">
      {site.resume && <a class="btn btn-primary" href={site.resume} target="_blank" rel="noopener">My Resume <span aria-hidden="true">↗</span></a>}
      <a class:list={["btn", site.resume ? "btn-secondary" : "btn-primary"]} href={site.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
      {!site.resume && <a class="btn btn-secondary" href="/work/">See my work <span aria-hidden="true">→</span></a>}
    </div>
  </section>

  <!-- About — in brief -->
  <section class="intro page px" id="about">
    <p class="section-label label-m muted">About — in brief</p>
    <p class="intro-text body-l"><strong>Over the past two years,</strong> I’ve gone from a computer science degree at UPES to designing healthcare analytics dashboards, a 60-page company website and client-facing visual systems. I care about interfaces that stay clear and consistent, built around the people who use them.</p>
  </section>

  <SkillsMarquee />

  <!-- Featured work -->
  <section class="featured" id="featured-work">
    <div class="page px fw-header">
      <div class="fw-title">
        <p class="label-m accent">Selected work · 2024 — 2026</p>
        <h2 class="display d-xl">Featured Work</h2>
        <p class="body-l muted fw-sub">Healthcare tools, product sites and data stories, designed to make complex information clear.</p>
      </div>
      <a class="pill-btn pill-btn-primary desktop-only" href="/work/">View all work <span class="count">{projects.length}</span> <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <div class="page px desktop-only"><FeaturedStack /></div>
    <div class="mobile-only"><FeaturedCarousel /></div>
    <div class="page px fw-footer">
      <div class="more">
        <span class="label-s muted">Also on the Work page</span>
        <a class="tag" href="/ai-x-design/">AI × Design</a>
        <a class="tag" href="/work/#smaller-projects">More short projects</a>
      </div>
      <a class="pill-btn pill-btn-ghost" href="/work/">Browse the Work page <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- Experience -->
  <section class="experience page px">
    <h2 class="display d-l accent">Experience</h2>
    <ul class="xp-list">
      {experience.map((x) => (
        <li class="xp reveal">
          <div class="xp-top">
            <div class="xp-who">
              <p class="label-m">{x.org}</p>
              <p class="h4">{x.role}</p>
            </div>
            <p class="label-m muted">{x.when}</p>
          </div>
          <p class="body-m muted xp-text">{x.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Stats -->
  <section class="stats page px" aria-label="In numbers">
    {stats.map((s) => (
      <div class="stat reveal">
        <p class="display d-xl accent">{s.value}</p>
        <p class="label-m muted">{s.label}</p>
      </div>
    ))}
  </section>

  <!-- Toolkit -->
  <section class="toolkit page px">
    <h2 class="display d-m">Toolkit</h2>
    <ul class="tool-grid">
      {tools.map((t) => (
        <li class="tool">
          <span class="tool-logo label-m accent" aria-hidden="true">{t.mono}</span>
          <span class="tool-text">
            <span class="h4">{t.name}</span>
            <span class="label-s muted">{t.cat}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Beyond pixels -->
  <section class="beyond page px">
    <p class="statement">Beyond pixels, I keep building things: games, small tools and AI experiments. Making them reminds me how design actually gets built.</p>
  </section>
</Base>

<style>
  .desktop-only { display: block; }
  .mobile-only { display: none; }
  @media (max-width: 1100px) {
    .desktop-only { display: none !important; }
    .mobile-only { display: block; }
  }

  /* hero */
  .hero { display: flex; flex-direction: column; gap: 56px; padding-top: var(--section-s); padding-bottom: 120px; }
  .name-row { display: flex; align-items: flex-end; gap: 40px; }
  .name { font-size: var(--type-display-xxl); line-height: 0.9; }
  .role { padding-bottom: 28px; line-height: 2; }
  .manifesto { display: flex; flex-direction: column; gap: 8px; }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; }

  /* intro */
  .intro { display: flex; flex-direction: column; gap: 32px; padding-bottom: 40px; scroll-margin-top: 24px; }
  .intro-text { max-width: 960px; line-height: 1.45; }
  .intro-text strong { font-weight: 600; }

  /* featured */
  .featured { padding-top: var(--section-m); padding-bottom: var(--section-m); scroll-margin-top: 24px; }
  .fw-header { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 64px; gap: 24px; }
  .fw-title { display: flex; flex-direction: column; gap: 20px; }
  .fw-sub { max-width: 440px; }
  .fw-footer { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
  .more { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

  /* experience */
  .experience { padding-bottom: 120px; }
  .xp-list { margin-top: 48px; }
  .xp { border-top: 1px solid var(--border); padding: 28px 0; display: flex; flex-direction: column; gap: 12px; }
  .xp-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; }
  .xp-who { display: flex; flex-direction: column; gap: 6px; }
  .xp-text { max-width: 720px; }

  /* stats */
  .stats { display: flex; gap: 160px; padding-bottom: var(--section-l); }
  .stat { display: flex; flex-direction: column; gap: 20px; }

  /* toolkit */
  .toolkit { display: flex; flex-direction: column; gap: 32px; padding-bottom: var(--section-xl); }
  .tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .tool { display: flex; align-items: center; gap: 20px; padding: 24px; border-radius: 20px; background: var(--bg-surface); border: 1px solid var(--border); transition: border-color 250ms, transform 250ms var(--ease); }
  .tool:hover { border-color: rgba(0, 212, 180, 0.4); transform: translateY(-2px); }
  .tool-logo { width: 56px; height: 56px; flex: none; border-radius: 14px; background: var(--bg-raised); display: grid; place-items: center; }
  .tool-text { display: flex; flex-direction: column; gap: 6px; line-height: 1.4; }

  /* beyond pixels */
  .beyond { padding-bottom: var(--section-l); }
  .statement { font-size: var(--type-statement); line-height: 1.3; font-weight: 600; max-width: 900px; }

  @media (max-width: 1100px) {
    .stats { gap: 80px; }
    .tool-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero { gap: 32px; padding-top: 48px; padding-bottom: 80px; }
    .name-row { flex-direction: column; align-items: flex-start; gap: 16px; }
    .role { padding-bottom: 0; }
    .featured { padding-top: 64px; padding-bottom: 64px; }
    .fw-header { padding-bottom: 32px; }
    .fw-footer { flex-direction: column; align-items: stretch; border-top: 0; margin-top: 0; padding-top: 32px; }
    .fw-footer .more { display: none; }
    .fw-footer .pill-btn { justify-content: center; }
    .xp-list { margin-top: 48px; }
    .stats { flex-direction: column; gap: 32px; padding-bottom: 80px; }
    .stat { gap: 8px; }
    .tool-grid { grid-template-columns: 1fr; gap: 12px; }
    .toolkit { gap: 24px; padding-bottom: 96px; }
    .beyond { padding-bottom: 80px; }
  }
</style>
