---
import Base from "../../layouts/Base.astro";
import { hero, workflow, stages, fig01, fig02, fig03, fig04, fig05, fig06 } from "../../data/ai-design";

const stageBy = Object.fromEntries(stages.map((s) => [s.key, s]));
/* Map label positions, as % of the 1280 × 420 Figma diagram. */
const mapPos: Record<string, number> = { discover: 12.5, define: 35.16, ideate: 60.55, prototype: 70.7, validate: 82.42, deliver: 92.19 };
const edges = [
  { t: "Diverge", x: 16.4, r: -21.8 },
  { t: "Converge", x: 30.86, r: 21.8 },
  { t: "Diverge", x: 69.77, r: -21.8 },
  { t: "Converge", x: 84.22, r: 21.8 },
];
const weightLabel = { full: "Full stage", light: "Light touch", skip: "Skip or reuse earlier work" };
---
<Base title="AI × Design" description="How Ananya designs anything with Claude: a six-stage workflow, who does what, the toolkit, guardrails, tuning dials and presets." active="ai">
  <header class="hero page px">
    <p class="label-m accent">{hero.label}</p>
    <h1 class="display d-xl">{hero.title}</h1>
    <p class="body-l muted intro">{hero.intro}</p>
  </header>

  <div class="workflow page px">
    <section class="wf-head" aria-labelledby="wf-title">
      <p class="section-label label-m muted">{workflow.label}</p>
      <h2 id="wf-title" class="display d-m">{workflow.title}</h2>
      <p class="body-l muted measure">{workflow.intro}</p>
    </section>

    <!-- Fig 01 — the map -->
    <section class="fig" aria-labelledby="f1">
      <div class="fig-head">
        <p class="label-s accent">{fig01.kicker}</p>
        <h3 id="f1" class="h3">{fig01.title}</h3>
        <p class="body-s muted measure">{fig01.body}</p>
      </div>
      <p class="label-s muted swipe">Swipe to see the whole map →</p>
      <div class="map-scroll">
        <div class="map">
          <svg viewBox="0 0 1280 420" aria-hidden="true">
            <defs>
              <marker id="ah" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="#93a39f" />
              </marker>
            </defs>
            <path class="loop" d="M1279 182 C1279 330 960 338 640 338 C320 338 2 330 2 196" marker-end="url(#ah)" />
            <polygon class="dia" points="1,180 300,60 599,180 300,300" />
            <polygon class="dia" points="681,180 980,60 1279,180 980,300" />
            <line class="bridge" x1="602" y1="180" x2="678" y2="180" />
          </svg>
          <p class="space" style="left:23.44%"><span class="label-s muted">Problem space</span><span class="space-t">Design the right thing</span></p>
          <p class="space" style="left:76.56%"><span class="label-s muted">Solution space</span><span class="space-t">Design the thing right</span></p>
          {edges.map((e) => <span class="edge label-s muted" style={`left:${e.x}%;transform:translate(-50%,-50%) rotate(${e.r}deg)`}>{e.t}</span>)}
          {stages.map((s) => (
            <button class="node" style={`left:${mapPos[s.key]}%`} data-stage={s.key} aria-label={`${s.n} ${s.name}: show this stage`}>
              <span class="label-s accent">{s.n}</span><span class="node-name">{s.name}</span>
            </button>
          ))}
          <p class="loop-label"><span class="label-s accent">06 → 01&nbsp;&nbsp;Learn and loop</span><span class="body-s muted">Feedback and results start the next round</span></p>
        </div>
      </div>
      <p class="label-s muted hint">Hover or tap a stage to light up its card</p>
      <ol class="stage-cards">
        {stages.map((s, i) => (
          <>
            <li class="stage-card" data-stage={s.key} tabindex="0">
              <p class="sc-name"><span class="accent">{s.n}</span> {s.name}</p>
              <p class="sc-body">{s.body}</p>
              <div class="sc-gate">
                <p class="label-s accent"><span class="gem" aria-hidden="true"></span>Gate</p>
                <p class="sc-gate-t">{s.gate}</p>
              </div>
            </li>
            {i < stages.length - 1 && <li class="gate-sep" aria-hidden="true"><span class="gem"></span></li>}
          </>
        ))}
      </ol>
    </section>

    <!-- Fig 02 — Claude and me -->
    <section class="fig" aria-labelledby="f2">
      <div class="fig-head">
        <p class="label-s accent">{fig02.kicker}</p>
        <h3 id="f2" class="h3">{fig02.title}</h3>
        <p class="body-s muted measure">{fig02.body}</p>
      </div>
      <div class="lanes" role="table" aria-label="Who does what at each stage">
        <div class="lane lane-head" role="row">
          <span class="label-s muted" role="columnheader">Stage</span>
          <span class="label-s accent" role="columnheader"><i class="dot dot-c"></i>Claude does</span>
          <span class="label-s" role="columnheader"><i class="dot dot-m"></i>I own</span>
          <span class="label-s muted" role="columnheader">How I use Claude</span>
        </div>
        {fig02.rows.map((r) => (
          <div class="lane" role="row" data-stage={r.stage}>
            <p class="lane-stage" role="rowheader"><span class="label-s accent">{stageBy[r.stage].n}</span><span class="label-m">{stageBy[r.stage].name}</span></p>
            <div class="cell cell-c" role="cell"><p class="cell-k label-s accent"><i class="dot dot-c"></i>Claude does</p><ul>{r.claude.map((t) => <li>{t}</li>)}</ul></div>
            <div class="cell cell-m" role="cell"><p class="cell-k label-s"><i class="dot dot-m"></i>I own</p><ul>{r.me.map((t) => <li>{t}</li>)}</ul></div>
            <p class="lane-how body-s muted" role="cell"><span class="cell-k label-s muted">How I use Claude</span>{r.how}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Fig 03 — toolkit -->
    <section class="fig" aria-labelledby="f3">
      <div class="fig-head">
        <p class="label-s accent">{fig03.kicker}</p>
        <h3 id="f3" class="h3">{fig03.title}</h3>
        <p class="body-s muted measure">{fig03.body}</p>
      </div>
      <div class="chips" role="group" aria-label="Filter the toolkit by stage">
        <button class="chip" aria-pressed="true" data-filter="all">All twelve</button>
        {stages.map((s) => <button class="chip" aria-pressed="false" data-filter={s.key}>{s.n} {s.name}</button>)}
      </div>
      <ul class="tools">
        {fig03.tools.map((t) => (
          <li class="tool" data-stages={t.stages.join(" ")}>
            <p class="label-s accent">{t.tag}</p>
            <h4 class="tool-t">{t.title}</h4>
            <p class="tool-b">{t.body}</p>
            <div class="tool-seen"><p class="label-s muted">Seen in</p><p class="tool-s">{t.seen}</p></div>
          </li>
        ))}
      </ul>
      <p class="label-s muted swipe">Swipe for all twelve →</p>
    </section>

    <!-- Fig 04 — loop + guardrails -->
    <section class="fig" aria-labelledby="f4">
      <div class="fig-head">
        <p class="label-s accent">{fig04.kicker}</p>
        <h3 id="f4" class="h3">{fig04.title}</h3>
        <p class="body-s muted measure">{fig04.body}</p>
      </div>
      <div class="loop-wrap">
        <ol class="steps">
          {fig04.steps.map((s, i) => (
            <>
              <li class:list={["step", { claude: s.owner !== "Me" }]}>
                <p class="step-top"><span class="label-m">{s.n}&nbsp;&nbsp;{s.name}</span><span class:list={["owner", { "owner-c": s.owner !== "Me" }]}>{s.owner}</span></p>
                <p class="step-b">{s.body}</p>
              </li>
              {i < fig04.steps.length - 1 && <li class="arrow-sep" aria-hidden="true">→</li>}
            </>
          ))}
        </ol>
        <p class="back body-s muted"><span class="accent" aria-hidden="true">↺</span>{fig04.back}</p>
      </div>
      <div class="guard">
        <p class="label-s accent">{fig04.guardrailsLabel}</p>
        <ul class="rules">
          {fig04.guardrails.map((g) => <li><h4 class="h4">{g.title}</h4><p class="body-s muted">{g.body}</p></li>)}
        </ul>
      </div>
    </section>

    <!-- Fig 05 — dials -->
    <section class="fig" aria-labelledby="f5">
      <div class="fig-head">
        <p class="label-s accent">{fig05.kicker}</p>
        <h3 id="f5" class="h3">{fig05.title}</h3>
        <p class="body-s muted measure">{fig05.body}</p>
      </div>
      <p class="label-s muted hint">Drag a dial. The further it turns up, the more its change applies.</p>
      <div class="dials">
        {fig05.dials.map((d) => (
          <div class="dial" style="--v:100">
            <div class="dial-name">
              <p class="label-s accent">{d.n}</p>
              <h4 class="h4">{d.name}</h4>
              <p class="body-s muted">{d.q}</p>
            </div>
            <div class="dial-range">
              <input type="range" min="0" max="100" value="100" aria-label={`${d.name}: ${d.q}`} aria-valuetext="High" />
              <p class="ends"><span class="label-s muted">{d.low}</span><span class="label-s accent">{d.high}</span></p>
            </div>
            <div class="dial-up">
              <p class="label-s muted">Turned up</p>
              <p class="body-s">{d.up}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Fig 06 — presets -->
    <section class="fig" aria-labelledby="f6">
      <div class="fig-head">
        <p class="label-s accent">{fig06.kicker}</p>
        <h3 id="f6" class="h3">{fig06.title}</h3>
        <p class="body-s muted measure">{fig06.body}</p>
      </div>
      <div class="matrix" role="table" aria-label="Stage weight for each project type">
        <div class="mrow mhead" role="row">
          <span class="label-s muted" role="columnheader">Project</span>
          {stages.map((s) => <span class="label-s muted mcol" role="columnheader">{s.name}</span>)}
          <span class="label-s muted" role="columnheader">The key change</span>
        </div>
        {fig06.presets.map((p) => (
          <div class="mrow" role="row">
            <p class="mproj" role="rowheader"><span class="mname">{p.name}</span><span class="body-s muted">{p.sub}</span></p>
            {p.w.map((w, i) => (
              <span class="mcell" role="cell">
                <span class="mlabel label-s muted">{stages[i].name}</span>
                <i class:list={["wt", w]} title={weightLabel[w]}></i>
                <span class="sr-only">{weightLabel[w]}</span>
              </span>
            ))}
            <p class="mkey body-s" role="cell">{p.key}</p>
          </div>
        ))}
      </div>
      <p class="legend body-s muted">
        <span><i class="wt full"></i>Full stage</span>
        <span><i class="wt light"></i>Light touch</span>
        <span><i class="wt skip"></i>Skip or reuse earlier work</span>
      </p>
    </section>
  </div>
</Base>

<script>
  /* Stage highlight: map nodes, stage cards and Claude-and-me rows share data-stage. */
  const stageEls = [...document.querySelectorAll<HTMLElement>("[data-stage]")];
  const light = (k: string | null) => stageEls.forEach((el) => el.classList.toggle("is-on", el.dataset.stage === k));
  document.querySelectorAll<HTMLElement>(".node, .stage-card").forEach((el) => {
    el.addEventListener("mouseenter", () => light(el.dataset.stage!));
    el.addEventListener("focus", () => light(el.dataset.stage!));
    el.addEventListener("mouseleave", () => light(null));
    el.addEventListener("blur", () => light(null));
    el.addEventListener("click", () => {
      light(el.dataset.stage!);
      if (el.classList.contains("node")) {
        const card = document.querySelector<HTMLElement>(`.stage-card[data-stage="${el.dataset.stage}"]`);
        card?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
      }
    });
  });

  /* Toolkit filter. */
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const tools = [...document.querySelectorAll<HTMLElement>(".tool")];
  chips.forEach((c) => c.addEventListener("click", () => {
    const f = c.dataset.filter!;
    chips.forEach((x) => x.setAttribute("aria-pressed", String(x === c)));
    tools.forEach((t) => {
      const s = t.dataset.stages!.split(" ");
      t.classList.toggle("is-dim", f !== "all" && !s.includes("all") && !s.includes(f));
    });
  }));

  /* Dials. */
  document.querySelectorAll<HTMLElement>(".dial").forEach((d) => {
    const r = d.querySelector<HTMLInputElement>("input")!;
    const set = () => {
      d.style.setProperty("--v", r.value);
      const v = Number(r.value);
      r.setAttribute("aria-valuetext", v > 66 ? "High" : v > 33 ? "Medium" : "Low");
    };
    r.addEventListener("input", set);
    set();
  });
</script>

<style>
  .hero { display: flex; flex-direction: column; gap: 32px; padding-top: 96px; padding-bottom: 96px; }
  .intro { max-width: 720px; }
  .measure { max-width: 720px; }

  .workflow { display: flex; flex-direction: column; gap: 120px; padding-bottom: var(--section-m); }
  .wf-head { display: flex; flex-direction: column; gap: 24px; }
  .fig { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .fig-head { display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; }
  .hint { margin-top: -16px; }
  .swipe { display: none; }

  /* Fig 01 map */
  .map-scroll { overflow-x: auto; margin: 0 calc(var(--page-x) * -1); padding: 0 var(--page-x); scrollbar-width: thin; }
  .map { position: relative; aspect-ratio: 1280 / 420; min-width: 1000px; }
  .map svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dia { fill: #0a2e28; stroke: var(--accent); stroke-width: 1.5; }
  .bridge { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 6 6; }
  .loop { fill: none; stroke: #93a39f; stroke-width: 1.5; stroke-dasharray: 6 6; }
  .space { position: absolute; top: 0; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; text-align: center; }
  .space-t { font-size: 16px; line-height: 1.4; }
  .edge { position: absolute; top: 26.9%; white-space: nowrap; }
  .node { position: absolute; top: 42.6%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 8px 12px; border-radius: 12px; border: 1px solid transparent; transition: background-color 200ms, border-color 200ms, transform 250ms var(--ease); }
  .node-name { font-family: var(--font-mono); font-weight: 500; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; }
  .node:hover, .node:focus-visible, .node.is-on { background: rgba(0, 212, 180, 0.14); border-color: var(--accent); transform: translate(-50%, -50%) scale(1.06); }
  .loop-label { position: absolute; top: 85%; left: 48.44%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 6px; white-space: nowrap; }

  .stage-cards { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr) 16px) minmax(0, 1fr); gap: 12px; align-items: stretch; }
  .stage-card { display: flex; flex-direction: column; gap: 12px; padding: 20px; border-radius: 16px; background: var(--bg-surface); border: 1px solid var(--border); transition: border-color 250ms, transform 250ms var(--ease), background-color 250ms; outline: none; }
  .stage-card.is-on, .stage-card:hover, .stage-card:focus-visible { border-color: var(--accent); background: #0f201d; transform: translateY(-4px); }
  .sc-name { font-family: var(--font-mono); font-weight: 500; font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase; }
  .sc-body { font-size: 16px; line-height: 1.6; flex: 1; }
  .sc-gate { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; border-top: 1px solid var(--border); }
  .sc-gate .label-s { display: flex; align-items: center; gap: 8px; }
  .sc-gate-t { font-size: 16px; line-height: 1.6; color: var(--text-secondary); }
  .gem { display: inline-block; width: 8px; height: 8px; background: var(--accent); transform: rotate(45deg); }
  .gate-sep { display: grid; place-items: center; }
  .gate-sep .gem { width: 11px; height: 11px; }

  /* Fig 02 lanes */
  .lanes { display: flex; flex-direction: column; gap: 12px; }
  .lane { display: grid; grid-template-columns: 124px 1fr 1fr 140px; gap: 12px; align-items: stretch; border-radius: 16px; transition: background-color 250ms; }
  .lane-head { align-items: center; }
  .lane-head span { display: flex; align-items: center; gap: 8px; }
  .lane.is-on { background: rgba(0, 212, 180, 0.06); box-shadow: 0 0 0 1px rgba(0, 212, 180, 0.3); }
  .lane-stage { display: flex; flex-direction: column; gap: 4px; padding-top: 14px; }
  .cell { padding: 16px 20px; border-radius: 12px; }
  .cell ul { display: flex; flex-direction: column; gap: 8px; font-size: 16px; line-height: 1.5; }
  .cell-c { background: #0a2e28; color: var(--accent); }
  .cell-m { background: var(--bg-raised); }
  .cell-k { display: none; }
  .lane-how { padding-top: 14px; }
  .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; }
  .dot-c { background: var(--accent); }
  .dot-m { background: var(--text-primary); }

  /* Fig 03 toolkit */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -8px; }
  .chip { padding: 8px 16px; border-radius: 999px; border: 1px solid var(--border); font-family: var(--font-mono); font-weight: 500; font-size: 14px; letter-spacing: 0.06em; color: var(--text-secondary); white-space: nowrap; transition: color 200ms, background-color 200ms, border-color 200ms; }
  .chip:hover { color: var(--text-primary); border-color: var(--accent); }
  .chip[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--text-on-accent); }
  .tools { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .tool { display: flex; flex-direction: column; gap: 12px; padding: 24px; border-radius: 16px; background: var(--bg-surface); border: 1px solid var(--border); transition: opacity 300ms, border-color 300ms, transform 300ms var(--ease); }
  .tool:hover { border-color: var(--accent); transform: translateY(-4px); }
  .tool.is-dim { opacity: 0.25; }
  .tool-t { font-size: 20px; font-weight: 600; line-height: 1.4; }
  .tool-b { font-size: 16px; line-height: 1.6; color: var(--text-secondary); flex: 1; }
  .tool-seen { display: flex; flex-direction: column; gap: 12px; padding-top: 20px; margin-top: 8px; border-top: 1px solid var(--border); }
  .tool-s { font-size: 16px; line-height: 1.4; }

  /* Fig 04 loop */
  .loop-wrap { display: flex; flex-direction: column; gap: 16px; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr) 24px) minmax(0, 1fr); gap: 8px; align-items: stretch; }
  .step { display: flex; flex-direction: column; gap: 16px; padding: 20px; border-radius: 16px; background: var(--bg-surface); border: 1px solid var(--border); transition: transform 250ms var(--ease), border-color 250ms; }
  .step:hover { transform: translateY(-4px); border-color: var(--text-secondary); }
  .step.claude { border-color: var(--accent); }
  .step:nth-child(3) { background: #0a2e28; }
  .step:nth-child(3) .step-b { color: var(--accent); }
  .step-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; }
  .step-top .label-m { white-space: nowrap; }
  .owner { padding: 2px 8px; border-radius: 999px; background: var(--text-primary); color: var(--text-on-accent); font-family: var(--font-mono); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .owner-c { background: var(--accent); }
  .step-b { font-size: 16px; line-height: 1.6; }
  .arrow-sep { display: grid; place-items: center; color: var(--accent); font-size: 16px; }
  .back { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 12px; border: 1px dashed var(--border); }
  .guard { display: flex; flex-direction: column; gap: 24px; padding: 40px 32px; border-radius: 16px; background: var(--bg-surface); border: 1px solid var(--border); }
  .rules { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .rules li { display: flex; flex-direction: column; gap: 12px; }

  /* Fig 05 dials */
  .dials { display: flex; flex-direction: column; border-top: 1px solid var(--border); }
  .dial { display: grid; grid-template-columns: 260px minmax(0, 1fr) 400px; gap: 48px; align-items: start; padding: 32px 0; border-bottom: 1px solid var(--border); }
  .dial-name { display: flex; flex-direction: column; gap: 8px; }
  .dial-range { display: flex; flex-direction: column; gap: 12px; padding-top: 28px; }
  .ends { display: flex; justify-content: space-between; gap: 16px; }
  .dial-up { display: flex; flex-direction: column; gap: 8px; opacity: calc(0.3 + var(--v) * 0.007); transition: opacity 150ms; }
  .dial input { -webkit-appearance: none; appearance: none; width: 100%; height: 6px; border-radius: 999px; background: linear-gradient(90deg, #0d2b26, var(--accent) calc(var(--v) * 1%), var(--border) calc(var(--v) * 1%)); cursor: pointer; }
  .dial input::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: var(--text-primary); border: 4px solid var(--accent); box-shadow: 0 0 0 6px rgba(0, 212, 180, 0.15); }
  .dial input::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--text-primary); border: 4px solid var(--accent); }
  .dial input:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }

  /* Fig 06 presets */
  .matrix { border-radius: 16px; border: 1px solid var(--border); background: var(--bg-surface); overflow: hidden; }
  .mrow { display: grid; grid-template-columns: 240px repeat(6, 84px) minmax(0, 1fr); align-items: center; gap: 0; padding: 20px 20px; border-top: 1px solid var(--border); transition: background-color 200ms; }
  .mrow:not(.mhead):hover { background: var(--bg-raised); }
  .mhead { border-top: 0; background: var(--bg-raised); padding-top: 20px; padding-bottom: 20px; }
  .mcol { text-align: center; }
  .mhead .mcol { font-size: 12px; letter-spacing: 0.04em; }
  .mhead > span:last-child { padding-left: 24px; }
  .mproj { display: flex; flex-direction: column; gap: 4px; padding-right: 16px; }
  .mname { font-size: 18px; font-weight: 600; line-height: 1.4; }
  .mcell { display: grid; place-items: center; }
