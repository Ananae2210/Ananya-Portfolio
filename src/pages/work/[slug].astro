---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/projects";
export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.title} active="work">
  <section class="page px" style="padding-top:96px;padding-bottom:160px;display:flex;flex-direction:column;gap:32px;align-items:flex-start">
    <a class="label-m muted" href="/work/">← All work</a>
    <h1 class="display d-xl">{p.title}</h1>
    <p class="body-l muted" style="max-width:720px">{p.summary}</p>
    <p class="label-m accent">Full case study coming soon</p>
  </section>
</Base>
