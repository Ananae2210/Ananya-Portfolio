---
import Base from "../../../layouts/Base.astro";
import { screens, done, FRAME_W, START } from "../../../data/cohort-prototype";

const PAD = 8; // frame px added around each hotspot so small links are easier to hit
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const box = (s: { x: number; y: number; w: number; h: number }, h: number) =>
  `left:${pct(s.x - PAD, FRAME_W)};top:${pct(s.y - PAD, h)};width:${pct(s.w + PAD * 2, FRAME_W)};height:${pct(s.h + PAD * 2, h)}`;
---
<Base title="Cohort Builder prototype" description="A clickable recreation of the AI Cohort Builder: three routes to a patient cohort, with sample data." active="work">
  <header class="head page px">
    <a class="back label-m muted" href="/work/ai-cohort-builder/">← AI Cohort Builder case study</a>
    <p class="label-m accent">Clickable prototype</p>
    <h1 class="display d-l">Build a cohort yourself</h1>
    <p class="body-l muted intro">Three routes to a patient cohort: pick a standard one, describe your own in plain language, or request one that doesn’t exist yet. Click the screen, or use the buttons under it. Sample data only.</p>
  </header>

  <section class="proto page px" aria-label="Prototype" data-proto data-start={START}>
    <div class="bar">
      <h2 class="screen-title label-m" tabindex="-1" aria-live="polite" data-title>Choose a route</h2>
      <div class="ctrls">
        <button class="chip label-s" aria-pressed="false" data-hint>Show clickable areas</button>
        <button class="chip label-s" data-restart>Start again</button>
      </div>
    </div>

    <div class="stage" data-stage>
      {screens.map((s) => (
        <div class="screen" data-screen={s.id} data-title={s.title} hidden={s.id !== START}>
          <img
            src={`/images/cohort/proto/${s.id}.webp`}
            alt={s.alt}
            width="1600"
            height={Math.round((1600 * s.h) / FRAME_W)}
            loading={s.id === START ? "eager" : "lazy"}
            decoding="async"
          />
          {s.spots.map((sp) => (
            <button class="spot" style={box(sp, s.h)} data-to={sp.to} tabindex="-1" aria-hidden="true" title={sp.label}></button>
          ))}
        </div>
      ))}
      {Object.entries(done).map(([id, d]) => (
        <div class="screen done" data-screen={id} data-title={d.title} hidden>
          <div class="done-card">
            <span class="tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
            <p class="display d-m">{d.title}</p>
            <p class="body-m muted">{d.body}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="acts-wrap">
      <p class="label-s muted">On this screen</p>
      {screens.map((s) => (
        <div class="acts" data-acts={s.id} hidden={s.id !== START}>
          {s.spots.map((sp) => <button class="act" data-to={sp.to}>{sp.label}</button>)}
        </div>
      ))}
      {Object.keys(done).map((id) => (
        <div class="acts" data-acts={id} hidden>
          <button class="act act-primary" data-to={START}>Try another route</button>
          <a class="act" href="/work/ai-cohort-builder/">Back to the case study</a>
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-proto]")!;
  const start = root.dataset.start!;
  const stage = root.querySelector<HTMLElement>("[data-stage]")!;
  const title = root.querySelector<HTMLElement>("[data-title]")!;
  const hint = root.querySelector<HTMLButtonElement>("[data-hint]")!;
  const screens = new Map([...root.querySelectorAll<HTMLElement>("[data-screen]")].map((el) => [el.dataset.screen!, el]));
  const acts = new Map([...root.querySelectorAll<HTMLElement>("[data-acts]")].map((el) => [el.dataset.acts!, el]));
  let current = start;

  /* warm the cache for every screen one click away */
  const preload = (id: string) =>
    screens.get(id)?.querySelectorAll<HTMLElement>("[data-to]").forEach((b) => {
      const img = screens.get(b.dataset.to!)?.querySelector("img");
      if (img && !img.complete) { img.loading = "eager"; }
    });

  function show(id: string, opts: { push?: boolean; focus?: boolean } = {}) {
    if (!screens.has(id)) id = start;
    if (id === current && !opts.push) return;
    screens.get(current)!.hidden = true;
    acts.get(current)!.hidden = true;
    const next = screens.get(id)!;
    next.hidden = false;
    acts.get(id)!.hidden = false;
    current = id;
    title.textContent = next.dataset.title!;
    if (opts.push) history.pushState({ id }, "", id === start ? location.pathname : `#${id}`);
    const top = stage.getBoundingClientRect().top;
    if (top < 0) window.scrollTo({ top: window.scrollY + top - 24, behavior: "smooth" });
    if (opts.focus) title.focus({ preventScroll: true });
    preload(id);
  }

  root.addEventListener("click", (e) => {
    const t = (e.target as Element).closest<HTMLElement>("[data-to]");
    if (t) { show(t.dataset.to!, { push: true, focus: t.classList.contains("act") || e.detail === 0 }); return; }
    /* a click that misses every hotspot flashes them, like Figma does */
    if ((e.target as Element).closest(".screen:not(.done)")) {
      stage.classList.remove("flash");
      void stage.offsetWidth;
      stage.classList.add("flash");
    }
  });
  stage.addEventListener("animationend", () => stage.classList.remove("flash"));

  hint.addEventListener("click", () => {
    const on = hint.getAttribute("aria-pressed") !== "true";
    hint.setAttribute("aria-pressed", String(on));
    stage.classList.toggle("hints", on);
  });
  root.querySelector("[data-restart]")!.addEventListener("click", () => show(start, { push: true, focus: true }));

  window.addEventListener("popstate", () => show(location.hash.slice(1) || start));
  if (location.hash) show(location.hash.slice(1));
  preload(current);
</script>

<style>
  .head { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 80px; }
  .back { margin-bottom: 12px; transition: color 200ms; }
  .back:hover { color: var(--accent); }
  .intro { max-width: 760px; }

  .proto { display: flex; flex-direction: column; gap: 20px; padding-top: 56px; padding-bottom: var(--section-m); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .screen-title { color: var(--text-primary); outline-offset: 6px; }
  .ctrls { display: flex; gap: 8px; }
  .chip { padding: 10px 16px; border-radius: 999px; border: 1px solid var(--border); color: var(--text-secondary); transition: border-color 200ms, color 200ms, background-color 200ms; }
  .chip:hover { border-color: var(--accent); color: var(--text-primary); }
  .chip[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }

  .stage { position: relative; border-radius: 16px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-surface); box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.8); }
  .screen { position: relative; animation: in 320ms var(--ease); }
  @keyframes in { from { opacity: 0; } to { opacity: 1; } }
  .screen img { width: 100%; height: auto; background: #fff; }

  .spot { position: absolute; border-radius: 8px; cursor: pointer; transition: background-color 200ms, box-shadow 200ms; }
  .spot:hover { background: rgba(0, 212, 180, 0.12); box-shadow: inset 0 0 0 2px rgba(0, 212, 180, 0.7); }
  .stage.hints .spot { background: rgba(0, 212, 180, 0.18); box-shadow: inset 0 0 0 2px var(--accent); }
  .stage.flash .spot { animation: flash 700ms var(--ease); }
  @keyframes flash { 0%, 100% { background: transparent; box-shadow: none; } 30%, 70% { background: rgba(0, 212, 180, 0.28); box-shadow: inset 0 0 0 2px var(--accent); } }

  .done { aspect-ratio: 1845 / 1119; display: grid; place-items: center; padding: 40px; background: radial-gradient(circle at 50% 40%, var(--accent-soft), var(--bg-surface) 70%); }
  .done-card { display: flex; flex-direction: column; align-items: center; gap: 16px; max-width: 520px; text-align: center; }
  .tick { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; background: var(--accent); color: var(--text-on-accent); margin-bottom: 8px; }
  .tick svg { width: 50%; height: 50%; }

  .acts-wrap { display: flex; flex-direction: column; gap: 12px; }
  .acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .act { padding: 10px 18px; border-radius: 999px; border: 1px solid var(--border); background: var(--bg-surface); font-size: 14px; line-height: 1.4; transition: border-color 200ms, color 200ms; }
  .act:hover { border-color: var(--accent); color: var(--accent); }
  .act-primary { background: var(--accent); border-color: var(--accent); color: var(--text-on-accent); }
  .act-primary:hover { background: #000; color: var(--text-primary); }

  @media (max-width: 760px) {
    .head { gap: 16px; padding-top: 48px; }
    .proto { padding-top: 40px; gap: 16px; }
    .stage { border-radius: 10px; }
    .done { aspect-ratio: auto; padding: 48px 20px; }
    .tick { width: 56px; height: 56px; }
    .act { padding: 12px 16px; }
  }
</style>
