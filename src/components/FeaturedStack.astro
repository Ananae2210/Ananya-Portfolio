---
import PreviewWindow from "./PreviewWindow.astro";
import { projects, projectHref } from "../data/projects";
---
<div class="stack" data-stack>
  <ol class="rows" role="tablist" aria-label="Featured projects">
    {projects.map((p, i) => (
      <li class:list={["row", { active: i === 0 }]} data-row={i}>
        <button class="row-head" role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`fw-${p.slug}`} data-select={i}>
          <span class="label-m num">{p.index}</span>
          <span class="display d-s title">{p.title}</span>
        </button>
        <div class="row-body" id={`fw-${p.slug}`} role="tabpanel">
          <div class="row-body-inner">
            <p class="body-l muted">{p.short}</p>
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            <a class="open" href={projectHref(p)}>Open case study <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <span class="progress" aria-hidden="true"><span></span></span>
      </li>
    ))}
  </ol>

  <div class="windows" aria-hidden="true">
    <div class="glow"></div>
    {projects.map((p, i) => (
      <a href={projectHref(p)} class="win" data-win={i} tabindex="-1">
        <PreviewWindow url={p.url} image={p.preview} alt="" small eager />
      </a>
    ))}
  </div>
</div>

<script>
  const DURATION = 5000;
  document.querySelectorAll<HTMLElement>("[data-stack]").forEach((stack) => {
    const rows = [...stack.querySelectorAll<HTMLElement>("[data-row]")];
    const wins = [...stack.querySelectorAll<HTMLElement>("[data-win]")];
    const n = rows.length;
    let active = 0;
    let timer: number | undefined;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const render = () => {
      rows.forEach((r, i) => {
        r.classList.toggle("active", i === active);
        r.querySelector("[role=tab]")!.setAttribute("aria-selected", String(i === active));
      });
      wins.forEach((w, i) => {
        const depth = (i - active + n) % n; // 0 = front
        w.dataset.depth = String(depth);
      });
    };
    const go = (i: number) => { active = (i + n) % n; render(); restart(); };
    const restart = () => {
      window.clearTimeout(timer);
      stack.style.setProperty("--dur", `${DURATION}ms`);
      rows.forEach((r) => r.classList.remove("timing"));
      void stack.offsetWidth;
      if (!reduced && !stack.matches(":hover")) {
        rows[active].classList.add("timing");
        timer = window.setTimeout(() => go(active + 1), DURATION);
      }
    };
    stack.querySelectorAll<HTMLElement>("[data-select]").forEach((b) => b.addEventListener("click", () => go(Number(b.dataset.select))));
    stack.addEventListener("mouseenter", () => { window.clearTimeout(timer); rows.forEach((r) => r.classList.remove("timing")); });
    stack.addEventListener("mouseleave", restart);

    // only cycle while visible
    new IntersectionObserver(([e]) => { if (e.isIntersecting) restart(); else window.clearTimeout(timer); }).observe(stack);
    render();
  });
</script>

<style>
  .stack { display: grid; grid-template-columns: 490px 1fr; gap: 40px; align-items: center; min-height: 540px; }

  .rows { display: flex; flex-direction: column; gap: 8px; }
  .row { position: relative; border: 1px solid transparent; border-radius: 16px; transition: background-color 400ms var(--ease), border-color 400ms var(--ease); }
  .row.active { background: var(--bg-surface); border-color: var(--border); }
  .row-head { display: flex; align-items: baseline; gap: 24px; width: 100%; text-align: left; padding: 20px 16px 12px; }
  .num { color: var(--text-secondary); width: 18px; }
  .title { color: var(--text-secondary); transition: color 300ms; }
  .row:hover .title { color: var(--text-primary); }
  .row.active .num { color: var(--accent); }
  .row.active .title { color: var(--text-primary); }
  .row-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 450ms var(--ease); }
  .row.active .row-body { grid-template-rows: 1fr; }
  .row-body-inner { overflow: hidden; padding: 0 16px 0 58px; display: flex; flex-direction: column; gap: 16px; }
  .row.active .row-body-inner { padding-bottom: 28px; }
  .open { color: var(--accent); font-weight: 600; font-size: 16px; line-height: 1.4; }
  .open:hover { text-decoration: underline; text-underline-offset: 4px; }
  .progress { position: absolute; left: 16px; right: 16px; bottom: -1px; height: 2px; overflow: hidden; opacity: 0; }
  .row.active .progress { opacity: 1; }
  .progress span { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; transform: scaleX(0); }
  .row.active .progress span { transform: scaleX(0.35); }
  .row.timing .progress span { animation: fill var(--dur, 5s) linear forwards; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .windows { position: relative; height: 540px; }
  .glow { position: absolute; left: 18%; top: 30%; width: 60%; height: 50%; background: radial-gradient(closest-side, rgba(0, 212, 180, 0.35), transparent); filter: blur(30px); }
  .win { position: absolute; left: 6%; top: 20%; width: 78%; transform-origin: top right; transition: transform 700ms var(--ease), opacity 700ms var(--ease), filter 700ms var(--ease); }
  .win[data-depth="0"] { z-index: 4; transform: none; }
  .win[data-depth="1"] { z-index: 3; transform: translate(14%, -6%) scale(0.88); filter: brightness(0.55); }
  .win[data-depth="2"] { z-index: 2; transform: translate(26%, -11%) scale(0.77); filter: brightness(0.35); }
  .win[data-depth="3"] { z-index: 1; transform: translate(34%, -14%) scale(0.7); opacity: 0; }
  .win :global(.window) { transform: rotate(-2deg); }

  @media (max-width: 1100px) {
    .stack { grid-template-columns: 1fr; }
    .windows { height: auto; aspect-ratio: 16 / 10; }
  }
</style>
