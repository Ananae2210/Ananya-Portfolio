---
import { projects, projectHref } from "../data/projects";
---
<div class="carousel-wrap" data-carousel>
  <ul class="carousel" aria-label="Featured projects">
    {projects.map((p) => (
      <li class="card">
        <a href={projectHref(p)} class="card-link">
          <div class="thumb"><img src={`/images/previews/${p.preview}-sm.webp`} alt={`${p.title} screen`} width="923" height="560" loading="lazy" /></div>
          <div class="body">
            <div class="top label-m"><span class="accent">{p.index}</span><span class="muted">Case study ↗</span></div>
            <p class="display card-title">{p.title}</p>
            <p class="body-m muted">{p.short}</p>
            <div class="tags">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
        </a>
      </li>
    ))}
    <li class="card cta-card">
      <a href="/work/" class="card-link">
        <p class="label-m accent">More work</p>
        <p class="display card-title">See everything on the Work page</p>
        <span class="pill-btn pill-btn-primary">View all work <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </li>
  </ul>
  <div class="controls">
    <div class="pips" aria-hidden="true">{[...projects, 0].map((_, i) => <span class:list={["pip", { on: i === 0 }]}></span>)}</div>
    <span class="label-s muted">Swipe →</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((wrap) => {
    const list = wrap.querySelector<HTMLElement>(".carousel")!;
    const pips = [...wrap.querySelectorAll<HTMLElement>(".pip")];
    const cards = [...list.children] as HTMLElement[];
    list.addEventListener("scroll", () => {
      const x = list.scrollLeft;
      let idx = 0, best = Infinity;
      cards.forEach((c, i) => { const d = Math.abs(c.offsetLeft - list.offsetLeft - x); if (d < best) { best = d; idx = i; } });
      pips.forEach((p, i) => p.classList.toggle("on", i === idx));
    }, { passive: true });
  });
</script>

<style>
  .carousel {
    display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 0 var(--page-x); scroll-padding: 0 var(--page-x); scrollbar-width: none;
  }
  .carousel::-webkit-scrollbar { display: none; }
  .card { flex: 0 0 300px; scroll-snap-align: start; }
  .card-link { display: flex; flex-direction: column; height: 100%; min-height: 480px; border-radius: 20px; overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border); }
  .thumb { aspect-ratio: 300 / 180; overflow: hidden; background: #fff; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .body { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .top { display: flex; justify-content: space-between; }
  .card-title { font-size: 28px; line-height: 1; }
  .cta-card .card-link { justify-content: flex-end; gap: 20px; padding: 24px; background: var(--accent-soft); border-color: rgba(0, 212, 180, 0.3); }
  .cta-card .card-title { font-size: 36px; }
  .cta-card .pill-btn { align-self: flex-start; }
  .controls { display: flex; justify-content: space-between; align-items: center; padding: 32px var(--page-x) 0; }
  .pips { display: flex; gap: 6px; }
  .pip { width: 20px; height: 3px; border-radius: 3px; background: var(--border); transition: width 300ms var(--ease), background-color 300ms; }
  .pip.on { width: 40px; background: var(--accent); }
</style>
