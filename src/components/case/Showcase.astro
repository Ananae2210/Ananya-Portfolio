---
import type { CaseStudy } from "../../data/case-studies/types";
import Phone from "./Phone.astro";
interface Props { showcase: NonNullable<CaseStudy["showcase"]> }
const { showcase: s } = Astro.props;
---
<section class="showcase page px" aria-labelledby="showcase-title">
  <p class="section-label label-m muted">{s.link ? (s.link.label.toLowerCase().includes("code") ? "Under the hood" : "Try it yourself") : "The screens"}</p>
  {s.link && (
    <div class:list={["card", { phone: s.phone }]}>
      <div class="text">
        <h2 id="showcase-title" class="display d-m">{s.title}</h2>
        <p class="body-m muted">{s.body}</p>
        <a class="btn btn-primary" href={s.link.href} target="_blank" rel="noopener">{s.link.label} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="visual">
        {s.phone ? (
          <div class="phone-wrap"><Phone><img class="fill" src={s.image.src} alt={s.image.alt} width={s.image.w} height={s.image.h} loading="lazy" decoding="async" /></Phone></div>
        ) : (
          <img class="shot" src={s.image.src} alt={s.image.alt} width={s.image.w} height={s.image.h} loading="lazy" decoding="async" />
        )}
      </div>
    </div>
  )}
  {!s.link && <h2 id="showcase-title" class="sr-only">The screens</h2>}
  {s.grid && (
    <div class="grid-wrap">
      {s.link && <p class="label-s muted">{s.grid.caption}</p>}
      {!s.link && <p class="label-s muted">Click any screen to zoom</p>}
      <div class="grid">
        {s.grid.images.map((im) => (
          <button class="screen" data-zoom={im.src} data-zoom-alt={im.alt} aria-label={`Zoom: ${im.alt}`}>
            <img src={im.src} alt="" width={im.w} height={im.h} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .showcase { display: flex; flex-direction: column; gap: 32px; padding-top: var(--section-m); }
  .card { display: grid; grid-template-columns: 420px 1fr; gap: 80px; align-items: center; padding: 64px; border-radius: 32px; background: var(--bg-surface); border: 1px solid var(--border); }
  .card.phone { grid-template-columns: 1fr 1fr; padding: 56px 64px; }
  .text { display: flex; flex-direction: column; gap: 24px; align-items: flex-start; }
  .shot { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8); }
  .visual { display: flex; justify-content: center; }
  .phone-wrap { width: 220px; }
  .fill { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .grid-wrap { display: flex; flex-direction: column; gap: 16px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .screen { display: block; aspect-ratio: 632 / 383; overflow: hidden; border-radius: 14px; background: #fff; border: 1px solid var(--border); cursor: zoom-in; transition: transform 300ms var(--ease), box-shadow 300ms var(--ease); }
  .screen img { width: 100%; height: auto; }
  .screen:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -20px rgba(0, 212, 180, 0.35); }

  @media (max-width: 1100px) {
    .card, .card.phone { grid-template-columns: 1fr; gap: 40px; padding: 40px; }
  }
  @media (max-width: 760px) {
    .card, .card.phone { padding: 24px; border-radius: 20px; }
    .grid { grid-template-columns: 1fr; gap: 16px; }
    .phone-wrap { width: 200px; }
  }
</style>
