---
import type { Img } from "../../data/case-studies/types";
interface Props { pages: { kicker: string; title: string; quote: string; desktop: Img }[]; caption: string }
const { pages, caption } = Astro.props;
---
<div class="story">
  <div class="pages">
    {pages.map((p) => (
      <article class="pg">
        <p class="label-s accent">{p.kicker}</p>
        <h4 class="h4 title">{p.title}</h4>
        <p class="quote">{p.quote}</p>
        <button class="visual" data-zoom={p.desktop.src} data-zoom-alt={p.desktop.alt} aria-label={`Open the full ${p.title} page`}>
          <span class="thumb"><img src={p.desktop.src} alt="" width={p.desktop.w} height={p.desktop.h} loading="lazy" decoding="async" /></span>
          <span class="mini"><img src={p.desktop.src} alt="" width={p.desktop.w} height={p.desktop.h} loading="lazy" decoding="async" /></span>
        </button>
      </article>
    ))}
  </div>
  <p class="label-s muted">{caption}</p>
</div>

<style>
  .story { display: flex; flex-direction: column; gap: 24px; }
  .pages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .pg { display: flex; flex-direction: column; gap: 12px; padding: 18px; border-radius: 20px; background: var(--bg-surface); border: 1px solid var(--border); }
  .title { font-size: 20px; }
  .quote { font-size: 18px; line-height: 1.5; color: var(--text-secondary); flex: 1; }
  .visual { display: grid; grid-template-columns: 172fr 85fr; gap: 10px; height: 340px; margin-top: 8px; text-align: left; }
  .thumb, .mini { overflow: hidden; border-radius: 6px; background: #fff; transition: transform 250ms var(--ease); }
  .thumb img { width: 100%; height: auto; }
  .mini img { width: 100%; height: 100%; object-fit: fill; }
  .visual:hover .thumb, .visual:hover .mini { transform: translateY(-3px); }

  @media (max-width: 1100px) { .pages { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) {
    .pages { grid-template-columns: 1fr; }
    .quote { font-size: 16px; }
    .visual { height: 280px; }
  }
</style>
